# Server
PORT=8080
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://talkbridge:talkbridge@localhost:5432/talkbridge?sslmode=disable

# Speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Translation — Azure is faster (~50-150ms) and has 2M chars/month free
# Get key: portal.azure.com → Cognitive Services → Translator
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=global

# LLM translation fallback (used when AZURE_TRANSLATOR_KEY is not set)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
TRANSLATION_MODEL=openai/gpt-4o-mini
